# Core features require no secrets. AI is opt-in.
PORT=3000
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional text-only fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional private demo gate. Never put provider keys in browser fields.
DEMO_ACCESS_CODE=
AI_PER_MINUTE=4
AI_DAILY_LIMIT=40
# Optional durable, shared atomic rate limits across deployments/instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
