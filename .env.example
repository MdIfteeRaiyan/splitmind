# Core features require no secrets. AI is opt-in.
PORT=3000
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: comma-separated Gemini models tried when the main model is busy (503) or rate-limited (429).
# Leave unset for the default (gemini-3.1-flash-lite,gemini-2.5-flash); set empty to disable.
# GEMINI_FALLBACK_MODELS=
# Optional text-only fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional private demo gate. Never put provider keys in browser fields.
DEMO_ACCESS_CODE=
AI_PER_MINUTE=4
AI_DAILY_LIMIT=40
# Optional durable, shared atomic rate limits across deployments/instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
